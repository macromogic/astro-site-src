---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props { name: string; posts: Post[] }
const { name, posts } = Astro.props;
---

<BaseLayout title={name} noindex>
  <section class="section">
    <div class="container">
      <div class="has-text-centered page-header">
        <h1 class="title icon-text" style="justify-content: center; gap: 0.35em"><Icon name="fa6-solid:tag" /><span>{name}</span></h1>
        <p class="subtitle">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </div>
      <div class="narrow">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
