---
import PostPage from '../../components/PostPage.astro';
import { getAlternates, getPosts } from '../../lib/posts';

/** Original-language posts at their historical URLs. Translations live under /[lang]/posts/. */
export async function getStaticPaths() {
  const posts = await getPosts(import.meta.env.DEV); // newest first; drafts previewable in dev
  return Promise.all(posts.map(async (post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], alternates: await getAlternates(post, import.meta.env.DEV) },
  })));
}

const { post, newer, older, alternates } = Astro.props;
---

<PostPage post={post} newer={newer} older={older} alternates={alternates} />
