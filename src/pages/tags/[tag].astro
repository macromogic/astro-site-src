---
import TermPage from '../../components/TermPage.astro';
import { getPosts, indexTags } from '../../lib/posts';

export async function getStaticPaths() {
  const index = indexTags(await getPosts(import.meta.env.DEV));
  return [...index.values()].map((t) => ({ params: { tag: t.slug }, props: { name: t.name, posts: t.posts } }));
}
const { name, posts } = Astro.props;
---
<TermPage name={name} posts={posts} />
